{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/acceptance-cleanup-plan.v1.schema.json",
  "title": "AgentMesh Deploy Acceptance Cleanup Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "fingerprint", "projectId", "sourceCommit", "acceptanceSuiteId", "acceptanceSuiteFingerprint", "cleanupOwner", "cleanupDeadline", "resources", "unresolvedMutations", "providerMutationCount", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "AcceptanceCleanupPlan" },
    "id": { "type": "string", "pattern": "^cleanup-plan-[a-f0-9]{24}$" },
    "fingerprint": { "$ref": "#/$defs/sha256" },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "acceptanceSuiteId": { "type": "string", "pattern": "^acceptance-suite-[a-f0-9]{24}$" },
    "acceptanceSuiteFingerprint": { "$ref": "#/$defs/sha256" },
    "cleanupOwner": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$" },
    "cleanupDeadline": { "type": "string", "format": "date-time" },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "unresolvedMutations": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
    "providerMutationCount": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["pending-human", "no-cleanup-evidence"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "receiptSource": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "actionId", "method", "receiptFingerprint", "mutationCount"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "receiptFingerprint": { "$ref": "#/$defs/sha256" },
        "mutationCount": { "type": "integer", "minimum": 1 }
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider", "providerId", "type", "name", "lifecycle", "requiredDisposition", "costClass", "mutationCount", "sourceReceipts"],
      "properties": {
        "id": { "type": "string", "pattern": "^cleanup-item-[a-f0-9]{24}$" },
        "provider": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["managed", "adopted", "unknown"] },
        "requiredDisposition": { "enum": ["delete-or-retain", "restore-or-retain", "review-only"] },
        "costClass": { "enum": ["potential-recurring", "unknown"] },
        "mutationCount": { "type": "integer", "minimum": 1 },
        "sourceReceipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receiptSource" } }
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider", "actionId", "method", "mutationCount", "receiptFingerprint", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^cleanup-unresolved-[a-f0-9]{24}$" },
        "provider": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "mutationCount": { "type": "integer", "minimum": 1 },
        "receiptFingerprint": { "$ref": "#/$defs/sha256" },
        "reason": { "const": "provider-mutation-without-normalized-resource" }
      }
    }
  }
}
