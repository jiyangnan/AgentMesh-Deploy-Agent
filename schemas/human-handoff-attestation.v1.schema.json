{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/human-handoff-attestation.v1.json",
  "title": "AgentMesh Deploy Human Handoff Attestation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "fingerprint", "projectId", "sourceCommit", "handoffId", "handoffFingerprint", "actor", "verificationBasis", "results", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "HumanHandoffAttestation" },
    "id": { "type": "string", "pattern": "^human-attestation-[a-f0-9]{24}$" },
    "fingerprint": { "$ref": "#/$defs/sha256" },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40,64}$" },
    "handoffId": { "type": "string", "pattern": "^human-handoff-[a-f0-9]{24}$" },
    "handoffFingerprint": { "$ref": "#/$defs/sha256" },
    "actor": { "$ref": "#/$defs/actor" },
    "verificationBasis": { "const": "human-attestation" },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
    "status": { "enum": ["completed", "blocked"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$" },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "status", "reason", "verifiedAt"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^human-task-[a-f0-9]{24}$" },
        "status": { "enum": ["completed", "not-applicable", "blocked"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
