{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/provider-connection.v1.json",
  "title": "AgentMesh Deploy Provider Connection",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "projectId", "provider", "authMethod", "scope", "secretRefs", "version", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ProviderConnection" },
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "provider": { "type": "string" },
    "authMethod": { "type": "string" },
    "scope": { "type": "string" },
    "secretRefs": { "type": "object", "additionalProperties": { "type": "string" } },
    "copiedFrom": {
      "type": "object",
      "required": ["projectId", "connectionId", "version"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "connectionId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["unverified", "ready", "blocked", "archived"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "archivedAt": { "type": "string" },
    "identity": { "type": "object" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "verifiedAt": { "type": "string" },
    "lastProbe": { "type": "object" }
  },
  "additionalProperties": false
}
