{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/provider-acceptance-portfolio.v1.json",
  "title": "AgentMesh Deploy Provider Acceptance Portfolio",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "id", "fingerprint", "validationRelease",
    "requiredProviders", "requiredCapabilities", "sources", "coverage", "status", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ProviderAcceptancePortfolio" },
    "id": { "type": "string", "pattern": "^acceptance-portfolio-[a-f0-9]{24}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validationRelease": {
      "type": "object",
      "required": ["packageName", "packageVersion", "capabilityContractFingerprint"],
      "properties": {
        "packageName": { "const": "@agentmesh/deploy" },
        "packageVersion": { "type": "string" },
        "capabilityContractFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "requiredProviders": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }
    },
    "requiredCapabilities": { "type": "array", "items": { "$ref": "#/$defs/providerMethods" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "status": { "enum": ["passed", "incomplete"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "providerMethods": {
      "type": "object",
      "required": ["provider", "methods"],
      "properties": {
        "provider": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["provider", "methods", "reportIds"],
      "properties": {
        "provider": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "reportIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "projectId", "sourceCommit", "suiteId", "suiteFingerprint", "suiteCreatedAt", "qualifications"
      ],
      "properties": {
        "projectId": { "type": "string" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "suiteId": { "type": "string", "pattern": "^acceptance-suite-[a-f0-9]{24}$" },
        "suiteFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "suiteCreatedAt": { "type": "string", "format": "date-time" },
        "qualifications": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualification" }
        }
      },
      "additionalProperties": false
    },
    "suiteRef": {
      "type": "object",
      "required": ["projectId", "suiteId", "suiteFingerprint", "reportIds"],
      "properties": {
        "projectId": { "type": "string" },
        "suiteId": { "type": "string", "pattern": "^acceptance-suite-[a-f0-9]{24}$" },
        "suiteFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "reportIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["provider", "requiredMethods", "coveredMethods", "missingMethods", "suiteRefs", "status"],
      "properties": {
        "provider": { "type": "string" },
        "requiredMethods": { "type": "array", "items": { "type": "string" } },
        "coveredMethods": { "type": "array", "items": { "type": "string" } },
        "missingMethods": { "type": "array", "items": { "type": "string" } },
        "suiteRefs": { "type": "array", "items": { "$ref": "#/$defs/suiteRef" } },
        "status": { "enum": ["passed", "incomplete"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
