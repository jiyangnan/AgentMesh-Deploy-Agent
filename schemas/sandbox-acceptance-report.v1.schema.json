{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/sandbox-acceptance-report.v1.json",
  "title": "AgentMesh Deploy Sandbox Acceptance Report",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "id", "fingerprint", "projectId", "graphId", "graphFingerprint",
    "adapterPlanId", "adapterPlanFingerprint", "sandboxProfileId", "sandboxProfileFingerprint",
    "sandboxPreflightId", "sandboxPreflightFingerprint", "runId", "runRevision", "runFingerprint",
    "accountEnvironment", "accountEnvironmentBasis", "transportProvenance", "providers", "checks",
    "providerResults", "providerMutationsExecuted", "receiptCount", "status", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "SandboxAcceptanceReport" },
    "id": { "type": "string", "pattern": "^sandbox-acceptance-[a-f0-9]{24}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "graphId": { "type": "string", "pattern": "^graph-[a-f0-9]{24}$" },
    "graphFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapterPlanId": { "type": "string", "pattern": "^adapter-plan-[a-f0-9]{24}$" },
    "adapterPlanFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sandboxProfileId": { "type": "string", "pattern": "^sandbox-[a-f0-9]{24}$" },
    "sandboxProfileFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sandboxPreflightId": { "type": "string" },
    "sandboxPreflightFingerprint": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "runRevision": { "type": "integer", "minimum": 1 },
    "runFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "accountEnvironment": { "enum": ["test", "unspecified"] },
    "accountEnvironmentBasis": { "enum": ["user-declared", "none"] },
    "transportProvenance": { "enum": ["native-cli-fixed-host", "injected-test", "unrecorded"] },
    "providers": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "status", "message"],
        "properties": {
          "code": { "type": "string" },
          "status": { "enum": ["passed", "failed"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "providerResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "actionCount", "terminalActionCount", "receiptCount", "mutationCount", "status"],
        "properties": {
          "provider": { "type": "string" },
          "actionCount": { "type": "integer", "minimum": 0 },
          "terminalActionCount": { "type": "integer", "minimum": 0 },
          "receiptCount": { "type": "integer", "minimum": 0 },
          "mutationCount": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["passed", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "providerMutationsExecuted": { "type": "integer", "minimum": 0 },
    "receiptCount": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["passed", "not-qualified"] },
    "createdAt": { "type": "string" }
  },
  "additionalProperties": false
}
