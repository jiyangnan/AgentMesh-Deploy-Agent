{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh360.com/schemas/launch-recipe.v1.json",
  "title": "AgentMesh Deploy Launch Recipe",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "fingerprint", "projectId", "sourceRef", "requirements", "providers", "requiredConnections", "rationale", "humanDecisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "LaunchRecipe" },
    "id": { "type": "string" },
    "fingerprint": { "type": "string" },
    "projectId": { "type": "string" },
    "sourceRef": { "type": "object" },
    "requirements": { "type": "object" },
    "providers": { "type": "object" },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "selectedProvider", "provider", "applicability", "reason", "tradeoffs"],
        "properties": {
          "role": { "type": "string" },
          "selectedProvider": { "type": "string" },
          "provider": { "type": "string" },
          "applicability": { "type": "string" },
          "reason": { "type": "string" },
          "tradeoffs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "requiredConnections": { "type": "array" },
    "rationale": { "type": "array" },
    "humanDecisions": { "type": "array" },
    "cost": { "type": "object" },
    "createdAt": { "type": "string" }
  },
  "additionalProperties": false
}
